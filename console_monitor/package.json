{
  "name": "@focus.matters/console-monitor",
  "version": "0.1.15",
  "description": "Run and monitor long-lived console commands from agents over TCP and MCP.",
  "type": "module",
  "bin": {
    "cm": "./bin/cm.js",
    "console-monitor": "./bin/cm.js",
    "console-monitor-mcp": "./bin/console-monitor-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "etc",
    "README.md"
  ],
  "util-package": {
    "commands": {
      "cm": {
        "path": "bin/cm.js",
        "description": "Run arbitrary commands and expose their console output over TCP."
      }
    },
    "mcpServers": {
      "console-monitor": {
        "command": "npx",
        "args": [
          "-y",
          "@focus.matters/console-monitor",
          "mcp"
        ],
        "description": "Read and restart console processes launched with cm run."
      }
    },
    "skills": {
      "mcp-consumption": {
        "path": "etc/skills/mcp-consumption",
        "uses": [
          "mcp:console-monitor"
        ],
        "description": "Agent instructions for consuming the console-monitor MCP server."
      }
    },
    "manuals": {
      "tutorial": {
        "path": "etc/manuals/tutorial.md",
        "installPath": "docs/console-monitor/tutorial.md",
        "description": "Tutorial for cm run, TCP usage, and MCP configuration."
      }
    }
  },
  "scripts": {
    "start": "node ./bin/cm.js",
    "mcp": "node ./bin/console-monitor-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
