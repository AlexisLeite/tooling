{
  "name": "@focus.matters/console-monitor",
  "version": "0.1.0",
  "description": "Run and monitor long-lived console commands from agents over TCP and MCP.",
  "type": "module",
  "bin": {
    "cm": "./bin/cm.js",
    "console-monitor": "./bin/cm.js",
    "console-monitor-mcp": "./bin/console-monitor-mcp.js"
  },
  "files": [
    "bin",
    "src",
    "codex",
    "codex.resources.json",
    "README.md"
  ],
  "codex": {
    "resourcesVersion": 1,
    "manifest": "./codex.resources.json",
    "summary": {
      "commands": ["cm"],
      "mcpServers": ["console-monitor"],
      "skills": ["mcp-consumption"],
      "manuals": ["tutorial"]
    }
  },
  "scripts": {
    "start": "node ./bin/cm.js",
    "mcp": "node ./bin/console-monitor-mcp.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "UNLICENSED"
}
