{
  "name": "@focus.matters/win-notifier",
  "version": "1.0.2",
  "description": "Windows tray notification service with Codex completion notifications.",
  "files": [
    "bin",
    "hooks",
    "scripts",
    "src",
    "README.md"
  ],
  "util-package": {
    "binaries": {
      "win-notifier": {
        "path": "bin/WinNotifier.exe",
        "fileName": "WinNotifier.exe",
        "description": "Servicio de notificaciones de Windows residente en la bandeja del sistema."
      }
    },
    "hooks": {
      "codex-stop-notification": {
        "event": "Stop",
        "path": "hooks/win-notifier-stop.ps1",
        "fileName": "win-notifier-stop.ps1",
        "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{hookPath}\"",
        "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"{hookPath}\"",
        "timeout": 10,
        "statusMessage": "Enviando notificación de tarea completada",
        "description": "Muestra una notificación al finalizar cada tarea de Codex."
      }
    },
    "postInstall": {
      "start-win-notifier": {
        "path": "scripts/start-win-notifier.ps1",
        "shell": "powershell",
        "platform": "win32",
        "description": "Inicia o actualiza el servicio residente WinNotifier."
      }
    }
  },
  "scripts": {
    "build": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "check": "node -e \"JSON.parse(require('node:fs').readFileSync('package.json', 'utf8'));\""
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}
